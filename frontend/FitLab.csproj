<Project Sdk="Microsoft.NET.Sdk">

  <!-- Frontend: la aplicación de escritorio (pantallas y controles). Los datos y las reglas están en ../backend. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FitLab</AssemblyName>
    <RootNamespace>FitLab</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>CA1416;WFO1000;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\backend\FitLab.Backend.csproj" />
  </ItemGroup>

</Project>
