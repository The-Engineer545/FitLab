<Project Sdk="Microsoft.NET.Sdk">

  <!-- Backend: datos y reglas (base de datos, cuentas, fotos y armonía de colores). Sin pantallas. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Solo para leer fotos con el lector de imágenes de Windows (WebP y otros formatos que GDI+ no abre). -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FitLab.Backend</AssemblyName>
    <RootNamespace>FitLab</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Drawing" />
    <!-- Con UseWPF, .NET no agrega System.IO a los using automáticos. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

</Project>
